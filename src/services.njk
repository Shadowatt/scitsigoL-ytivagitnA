---
permalink: /services/index.html
title: "Services | Antigravity Logistics"
description: "Transport &amp; logistics, heavy handling, hospital &amp; medical equipment, residential moves, and disposal &amp; removal — across Sydney and NSW."
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}

  <style>
    /* ==========================================================================
       Services page — self-contained styles
       ========================================================================== */

    /* ---- Quote band (same pattern as homepage) ---- */

    .quote-band {
      background: linear-gradient(135deg, var(--black) 0%, #1a1b1d 100%);
      padding: 80px 0;
      position: relative;
      overflow: hidden;
    }

    .quote-band::before {
      content: '';
      position: absolute;
      right: -100px;
      top: -100px;
      width: 380px;
      height: 380px;
      background: var(--orange);
      opacity: 0.07;
      transform: rotate(45deg);
      pointer-events: none;
    }

    .quote-band::after {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 6px;
      height: 100%;
      background: var(--orange);
    }

    .quote-band-content {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 56px;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 800px) {
      .quote-band-content {
        grid-template-columns: 1fr;
        gap: 32px;
      }
    }

    .quote-band-eyebrow {
      display: inline-block;
      color: var(--orange);
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 14px;
    }

    .quote-band-text h2 {
      color: var(--white);
      margin-bottom: 12px;
      max-width: 22ch;
    }

    .quote-band-text p {
      color: #cfcfd1;
      margin: 0;
      max-width: 52ch;
      font-size: 1.05rem;
    }

    .quote-band .btn {
      padding: 18px 38px;
      font-size: 1.15rem;
      white-space: nowrap;
      border-color: var(--orange);
      background: var(--orange);
      color: var(--white);
    }

    .quote-band .btn:hover,
    .quote-band .btn:focus-visible {
      background: transparent;
      color: var(--orange);
    }

    @media (max-width: 480px) {
      .quote-band { padding: 56px 0; }
      .quote-band .btn { padding: 16px 28px; font-size: 1.05rem; }
      .quote-band-text h2 { font-size: 1.8rem; }
    }

    /* ---- Included-perks strip (visual checklist) ---- */

    .perks-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 2px;
      background: var(--grey-light);
      margin-top: 40px;
    }

    .perk {
      background: var(--white);
      padding: 28px 24px;
      text-align: left;
      transition: background 0.2s ease;
    }

    .perk:hover {
      background: var(--off-white);
    }

    .perk-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: var(--orange);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }

    .perk-icon svg { width: 20px; height: 20px; }

    .perk h3 {
      font-size: 1.05rem;
      font-weight: 700;
      margin: 0 0 4px;
    }

    .perk p {
      font-size: 0.9rem;
      color: #4d4d4f;
      margin: 0;
      line-height: 1.5;
    }

    /* ---- Section intro alignment ---- */

    .services-intro {
      max-width: 56ch;
      color: #cfcfd1;
      font-size: 1.05rem;
      margin: 0 0 8px;
    }
  </style>
</head>
<body>

{% include "header.njk" %}

<!-- ====== PAGE HEADER ====== -->

