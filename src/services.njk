---
permalink: /services/index.html
title: "Services | Antigravity Logistics"
description: "Residential removals, commercial relocations, transport &amp; logistics, heavy &amp; specialised handling, and removal &amp; disposal — across Sydney and NSW."
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}

  <style>
    /* ==========================================================================
       Services page — self-contained styles
       ========================================================================== */

    .services-intro {
      max-width: 56ch;
      color: #cfcfd1;
      font-size: 1.05rem;
      margin: 0 0 8px;
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 12px;
    }

    @media (max-width: 900px) { .service-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .service-grid { grid-template-columns: 1fr; } }

    .service-grid .service-card:first-child { grid-column: span 2; }

    @media (max-width: 900px) {
      .service-grid .service-card:first-child { grid-column: span 2; }
    }
    @media (max-width: 560px) {
      .service-grid .service-card:first-child { grid-column: span 1; }
    }

    .service-grid .service-card:first-child h3 { font-size: 1.7rem; }
    .service-grid .service-card:first-child p { font-size: 1.02rem; max-width: 60ch; }
    .service-grid .service-card:first-child .service-icon { width: 88px; height: 88px; }
    .service-grid .service-card:first-child .service-icon img { width: 42px; height: 42px; }

    /* ---- Perks strip ---------------------------------------------- */

    .perks-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-top: 40px;
    }

    .perk {
      background: var(--white);
      border: 1px solid var(--grey-light);
      border-radius: 12px;
      padding: 28px 24px;
      text-align: left;
      transition: transform 0.25s ease, box-shadow 0.3s ease, border-color 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .perk::before {
      content: '';
      position: absolute;
      top: 0; left: 0; bottom: 0;
      width: 3px;
      background: var(--orange);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.3s ease;
    }

    .perk:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(15, 16, 17, 0.08);
    }

    .perk:hover::before { transform: scaleY(1); }

    .perk-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: var(--black);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
      transition: background 0.25s ease, transform 0.3s ease;
    }

    .perk:hover .perk-icon {
      background: var(--orange);
      transform: scale(1.05) rotate(-3deg);
    }

    .perk-icon svg { width: 20px; height: 20px; }

    .perk h3 {
      font-size: 1.08rem;
      font-weight: 700;
      margin: 0 0 4px;
    }

    .perk p {
      font-size: 0.9rem;
      color: #4d4d4f;
      margin: 0;
      line-height: 1.5;
    }

    /* ---- Photo mosaic --------------------------------------------- */

    .photo-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 200px;
      gap: 16px;
      margin-top: 40px;
    }

    @media (max-width: 900px) {
      .photo-strip { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 180px; }
    }

    @media (max-width: 480px) {
      .photo-strip { grid-template-columns: 1fr; grid-auto-rows: 200px; }
    }

    .photo-strip-item {
      display: block;
      position: relative;
      overflow: hidden;
      border-radius: 12px;
      background: var(--grey-light);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .photo-strip-item:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }

    @media (max-width: 900px) {
      .photo-strip-item:first-child { grid-column: span 2; grid-row: span 1; }
    }
    @media (max-width: 480px) {
      .photo-strip-item:first-child { grid-column: span 1; }
    }

    .photo-strip-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.5s ease;
    }

    .photo-strip-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(15, 16, 17, 0.15);
    }

    .photo-strip-item:hover img { transform: scale(1.05); }

    /* ---- Stats band ----------------------------------------------- */

    .stats-band {
      background: var(--off-white);
      border-top: 1px solid var(--grey-light);
      border-bottom: 1px solid var(--grey-light);
      padding: 56px 0;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      text-align: center;
    }

    @media (max-width: 700px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }

    .stat-item .stat-num {
      display: block;
      font-family: var(--font-head);
      font-weight: 800;
      font-size: clamp(2.2rem, 5vw, 3.2rem);
      line-height: 1;
      color: var(--orange);
      margin-bottom: 8px;
    }

    .stat-item .stat-label {
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 1rem;
      color: var(--black);
      letter-spacing: 0.2px;
    }

    /* ---- Quote band ------------------------------------------------ */

    .quote-band {
      background: linear-gradient(135deg, var(--black) 0%, #1a1b1d 100%);
      padding: 80px 0;
      position: relative;
      overflow: hidden;
    }

    .quote-band::before {
      content: '';
      position: absolute;
      right: -100px;
      top: -100px;
      width: 380px;
      height: 380px;
      background: var(--orange);
      opacity: 0.07;
      transform: rotate(45deg);
      pointer-events: none;
    }

    .quote-band::after {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 6px;
      height: 100%;
      background: var(--orange);
    }

    .quote-band-content {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 56px;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 800px) {
      .quote-band-content { grid-template-columns: 1fr; gap: 32px; }
    }

    .quote-band-eyebrow {
      display: inline-block;
      color: var(--orange);
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 14px;
    }

    .quote-band-text h2 { color: var(--white); margin-bottom: 12px; max-width: 22ch; }

    .quote-band-text p {
      color: #cfcfd1;
      margin: 0;
      max-width: 52ch;
      font-size: 1.05rem;
    }

    .quote-band .btn {
      padding: 18px 38px;
      font-size: 1.15rem;
      white-space: nowrap;
      border-color: var(--orange);
      background: var(--orange);
      color: var(--white);
    }

    .quote-band .btn:hover,
    .quote-band .btn:focus-visible {
      background: transparent;
      color: var(--orange);
    }

    @media (max-width: 480px) {
      .quote-band { padding: 56px 0; }
      .quote-band .btn { padding: 16px 28px; font-size: 1.05rem; }
      .quote-band-text h2 { font-size: 1.8rem; }
    }
  </style>
</head>
