---
permalink: /quote/index.html
title: "Get a Quote | Antigravity Logistics"
description: "Request a free quote for residential removals, commercial relocations, transport, heavy handling and disposal across Sydney and NSW."
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}

  <style>
    /* ==========================================================================
       Quote page — self-contained styles
       ========================================================================== */

    .quote-layout {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 56px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .quote-layout { grid-template-columns: 1fr; gap: 40px; }
    }

    .quote-submit {
      width: 100%;
      text-align: center;
      font-size: 1.2rem;
      padding: 18px 30px;
      margin-top: 8px;
    }

    .quote-submit:disabled { opacity: 0.7; cursor: not-allowed; }

    .quote-note {
      font-size: 0.8rem;
      color: var(--grey);
      margin: 12px 0 0;
      text-align: center;
      max-width: 100%;
    }

    .info-block { margin-bottom: 40px; }

    .info-block h2 {
      font-size: 1.6rem;
      margin-bottom: 28px;
    }

    .next-steps {
      list-style: none;
      padding: 0;
      margin: 0;
      position: relative;
    }

    .next-steps::before {
      content: '';
      position: absolute;
      left: 17px;
      top: 20px;
      bottom: 20px;
      width: 2px;
      background: repeating-linear-gradient(
        to bottom,
        var(--orange) 0,
        var(--orange) 5px,
        transparent 5px,
        transparent 12px
      );
      opacity: 0.5;
      z-index: 0;
    }

    .next-step {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      padding: 0 0 24px;
      position: relative;
      z-index: 1;
    }

    .next-step:last-child { padding-bottom: 0; }

    .next-step-num {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--white);
      border: 3px solid var(--orange);
      color: var(--orange);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-head);
      font-weight: 800;
      font-size: 1rem;
      flex-shrink: 0;
      transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
    }

    .next-step:hover .next-step-num {
      background: var(--orange);
      color: var(--white);
      transform: scale(1.1);
    }

    .next-step p {
      margin: 6px 0 0;
      font-size: 1rem;
      color: var(--black);
      line-height: 1.5;
      max-width: 100%;
    }

    .call-card {
      padding: 26px 28px;
      background: linear-gradient(135deg, var(--off-white) 0%, #f0efec 100%);
      border-left: 4px solid var(--orange);
      border-radius: 0 12px 12px 0;
      position: relative;
      overflow: hidden;
    }

    .call-card::after {
      content: '';
      position: absolute;
      right: -40px;
      bottom: -40px;
      width: 140px;
      height: 140px;
      background: var(--orange);
      opacity: 0.06;
      border-radius: 50%;
      pointer-events: none;
    }

    .call-card h3 {
      font-size: 1.15rem;
      margin: 0 0 10px;
    }

    .call-card a {
      display: inline-block;
      font-family: var(--font-head);
      font-size: 1.7rem;
      font-weight: 700;
      color: var(--black);
      border-bottom: 3px solid var(--orange);
      padding-bottom: 2px;
      transition: color 0.2s ease;
      position: relative;
      z-index: 1;
    }

    .call-card a:hover { color: var(--orange); }

    .call-card .hours {
      color: var(--grey);
      font-size: 0.9rem;
      margin: 10px 0 0;
      position: relative;
      z-index: 1;
    }

    .reviews-summary {
      padding: 28px 26px;
      background: linear-gradient(135deg, #1e1f22 0%, #26282c 100%);
      border-left: 4px solid var(--orange);
      border-radius: 0 12px 12px 0;
      color: var(--white);
      position: relative;
      overflow: hidden;
    }

    .reviews-summary::after {
      content: '';
      position: absolute;
      right: -60px;
      top: -60px;
      width: 180px;
      height: 180px;
      background: var(--orange);
      opacity: 0.08;
      border-radius: 50%;
      pointer-events: none;
    }

    .reviews-summary h3 {
      font-family: var(--font-head);
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--white);
      margin: 0 0 16px;
      position: relative;
      z-index: 1;
    }

    .review-stars {
      display: flex;
      gap: 3px;
      color: #f5b342;
      font-size: 1.5rem;
      line-height: 1;
      letter-spacing: 1px;
      margin-bottom: 10px;
      position: relative;
      z-index: 1;
    }

    .review-rating {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
      position: relative;
      z-index: 1;
    }

    .review-rating .rating-num {
      font-family: var(--font-head);
      font-weight: 800;
      font-size: 2.4rem;
      line-height: 1;
      color: var(--orange);
      letter-spacing: 0.5px;
    }

    .review-rating .rating-out {
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 1.2rem;
      color: #9a9a9d;
    }

    .review-rating .rating-source {
      font-family: var(--font-body);
      font-size: 0.85rem;
      color: #9a9a9d;
      margin-left: 4px;
    }

    .rating-caption {
      font-size: 0.95rem;
      color: #cfcfd1;
      margin: 0 0 14px;
      max-width: 100%;
      position: relative;
      z-index: 1;
    }

    .reviews-summary .read-link {
      color: var(--orange);
      font-size: 0.9rem;
      text-decoration: underline;
      position: relative;
      z-index: 1;
    }

    .reviews-summary .read-link:hover { color: var(--white); }

    @media (max-width: 480px) {
      .call-card a { font-size: 1.4rem; }
      .review-stars { font-size: 1.25rem; }
      .review-rating .rating-num { font-size: 2rem; }
      .review-rating .rating-out { font-size: 1.05rem; }
      .review-rating .rating-source { font-size: 0.8rem; }
    }
  </style>
</head>
<body>

{% include "header.njk" %}

<section class="page-header">
  <div class="wrap">
    <div class="hero-eyebrow">Get a Quote</div>
    <h1>Tell us what you need moved</h1>
    <p class="lead" style="margin-top:16px;">Fill in the form below and we'll get back to you within 24 hours with a clear plan and price.</p>
  </div>
</section>

<div class="bar-divider"></div>

<section class="section">
  <div class="wrap">
    <div class="quote-layout">

      <!-- FORM COLUMN -->
      <div>
        <div id="formSuccess" class="form-success">
          <strong>✅ Thank you!</strong> Your quote request has been sent. We'll get back to you within 24 hours.
        </div>
        <div id="formError" class="form-error">
          <strong>❌ Something went wrong.</strong> Please try again or contact us directly by phone.
        </div>

        <form id="quoteForm" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE">
          <input type="checkbox" name="botcheck" style="display: none;">
          <input type="hidden" name="subject" value="New Quote Request from Antigravity Logistics">

          <div class="form-group">
            <label for="service">What service do you need? *</label>
            <select id="service" name="service" required>
              <option value="">— Please select —</option>
              <option value="residential">Residential Removals</option>
              <option value="commercial">Commercial Removals</option>
              <option value="transport">Transport &amp; Logistics</option>
              <option value="heavy-handling">Heavy &amp; Specialised Handling</option>
              <option value="disposal">Removal &amp; Disposal</option>
              <option value="other">Other / Not sure</option>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="name">Your name *</label>
              <input type="text" id="name" name="name" placeholder="John Smith" required>
            </div>
            <div class="form-group">
              <label for="email">Email address *</label>
              <input type="email" id="email" name="email" placeholder="john@example.com" required>
            </div>
          </div>

          <div class="form-group">
            <label for="phone">Phone number</label>
            <input type="tel" id="phone" name="phone" placeholder="0422 553 675">
          </div>

          <div class="form-group">
            <label for="message">Tell us about your job *</label>
            <textarea id="message" name="message" placeholder="What needs to be moved? Where from and to? Any stairs, tight access, or oversized items?" required></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="pickup">Pickup suburb / postcode</label>
              <input type="text" id="pickup" name="pickup" placeholder="e.g. Sydney, 2000">
            </div>
            <div class="form-group">
              <label for="delivery">Delivery suburb / postcode</label>
              <input type="text" id="delivery" name="delivery" placeholder="e.g. Parramatta, 2150">
            </div>
          </div>

          <button type="submit" class="btn quote-submit">Send Quote Request →</button>

          <p class="quote-note">We'll respond within 24 hours. Your details are safe with us.</p>
        </form>
      </div>

      <!-- INFO COLUMN -->
      <div>

        <div class="info-block">
          <h2>What happens next</h2>
          <ol class="next-steps">
            <li class="next-step">
              <span class="next-step-num">1</span>
              <p>We receive your request and review the details.</p>
            </li>
            <li class="next-step">
              <span class="next-step-num">2</span>
              <p>We ask any follow-up questions if needed.</p>
            </li>
            <li class="next-step">
              <span class="next-step-num">3</span>
              <p>We send you a custom plan and a clear price.</p>
            </li>
            <li class="next-step">
              <span class="next-step-num">4</span>
              <p>We lock in a date and get the job done.</p>
            </li>
          </ol>
        </div>

        <div class="info-block">
          <div class="call-card">
            <h3>Prefer to call?</h3>
            <a href="tel:+61422553675">0422 553 675</a>
            <p class="hours">Monday – Saturday, 7am – 7pm</p>
          </div>
        </div>

        <div class="reviews-summary">
          <h3>What our customers say</h3>
          <div class="review-stars" aria-label="Rated 4.8 or higher out of 5">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <div class="review-rating">
            <span class="rating-num">5</span>
            <span class="rating-out">/ 5</span>
            <span class="rating-source">from Google</span>
          </div>
          <p class="rating-caption">Highly rated by customers across Sydney and NSW.</p>
          <a href="https://www.google.com/search?q=antigravity+removals" target="_blank" rel="noopener" class="read-link">
            Read reviews on Google →
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

{% include "footer.njk" %}

<script>
// ============================================================
// 1. Pre-select service from URL (?service=transport)
// ============================================================

(function () {
  var params = new URLSearchParams(window.location.search);
  var serviceParam = params.get('service');
  if (!serviceParam) return;

  var select = document.getElementById('service');
  if (!select) return;

  for (var i = 0; i < select.options.length; i++) {
    if (select.options[i].value === serviceParam) {
      select.selectedIndex = i;
      select.style.transition = 'box-shadow 0.4s ease';
      select.style.boxShadow = '0 0 0 4px rgba(255, 80, 51, 0.25)';
      setTimeout(function () {
        select.style.boxShadow = 'none';
      }, 1400);
      break;
    }
  }
})();

// ============================================================
// 2. Form validation
// ============================================================

const form = document.getElementById('quoteForm');
const successDiv = document.getElementById('formSuccess');
const errorDiv = document.getElementById('formError');

if (form) {
  form.addEventListener('submit', function(e) {
    successDiv.classList.remove('is-visible');
    errorDiv.classList.remove('is-visible');

    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const service = document.getElementById('service').value;
    const message = document.getElementById('message').value.trim();

    if (!name || !email || !service || !message) {
      errorDiv.textContent = '❌ Please fill in all required fields (*).';
      errorDiv.classList.add('is-visible');
      e.preventDefault();
      return;
    }

    if (!email.includes('@') || !email.includes('.')) {
      errorDiv.textContent = '❌ Please enter a valid email address.';
      errorDiv.classList.add('is-visible');
      e.preventDefault();
      return;
    }

    const btn = form.querySelector('button[type="submit"]');
    btn.textContent = '⏳ Sending...';
    btn.disabled = true;

    setTimeout(() => {
      btn.textContent = 'Send Quote Request →';
      btn.disabled = false;
    }, 5000);
  });
}
</script>

</body>
</html>