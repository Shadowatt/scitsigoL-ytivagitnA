        </div>

        <form id="quoteForm" action="https://api.web3forms.com/submit" method="POST">
          <!-- Web3Forms access key – replace with your own -->
          <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE">

          <!-- Redirect to thank-you page (optional) -->
          <input type="hidden" name="redirect" value="https://yourdomain.com/quote/thank-you/">

          <!-- Bot protection (honeypot) -->
          <input type="checkbox" name="botcheck" style="display: none;">

          <!-- Hidden: identify the form -->
          <input type="hidden" name="subject" value="New Quote Request from Antigravity Logistics">

          <!-- Service selection -->
          <div class="form-group">
            <label for="service">What service do you need? *</label>
            <select id="service" name="service" required>
              <option value="">— Please select —</option>
              <option value="Transport & Logistics">Transport &amp; Logistics</option>
              <option value="Heavy Handling">Heavy Handling</option>
              <option value="Hospital & Medical Equipment">Hospital &amp; Medical Equipment</option>
              <option value="Residential Move">Residential Move</option>
              <option value="Disposal & Removal">Disposal &amp; Removal</option>
              <option value="Other / Not sure">Other / Not sure</option>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="name">Your name *</label>
              <input type="text" id="name" name="name" placeholder="John Smith" required>
            </div>
            <div class="form-group">
              <label for="email">Email address *</label>
              <input type="email" id="email" name="email" placeholder="john@example.com" required>
            </div>
          </div>

          <div class="form-group">
            <label for="phone">Phone number</label>
            <input type="tel" id="phone" name="phone" placeholder="0422 553 675">
          </div>

          <div class="form-group">
            <label for="message">Tell us about your job *</label>
            <textarea id="message" name="message" placeholder="What needs to be moved? Where from and to? Any stairs, tight access, or oversized items?" required></textarea>
          </div>

          <div class="form-group">
            <label for="pickup">Pickup suburb / postcode</label>
            <input type="text" id="pickup" name="pickup" placeholder="e.g. Sydney, 2000">
          </div>

          <div class="form-group">
            <label for="delivery">Delivery suburb / postcode</label>
            <input type="text" id="delivery" name="delivery" placeholder="e.g. Parramatta, 2150">
          </div>

          <button type="submit" class="btn" style="width: 100%; text-align: center; font-size: 1.2rem;">
            Send Quote Request →
          </button>

          <p style="font-size: 0.8rem; color: var(--grey); margin-top: 12px; text-align: center;">
            We'll respond within 24 hours. Your details are safe with us.
          </p>
        </form>
      </div>

      <!-- INFO COLUMN -->
      <div>
        <h2>What happens next?</h2>
        <ol style="list-style: decimal; padding-left: 20px; color: #4d4d4f; font-size: 1.05rem; line-height: 1.7;">
          <li>We receive your request</li>
          <li>We review the details</li>
          <li>We get back to you with a custom plan and price</li>
          <li>We schedule the job</li>
        </ol>

        <div style="margin-top: 32px; padding: 24px; background: var(--off-white); border-left: 4px solid var(--orange);">
          <h3 style="font-size: 1.2rem; margin-bottom: 6px;">Prefer to call?</h3>
          <p style="margin-bottom: 0;">
            <a href="tel:+61422553675" style="font-family: var(--font-head); font-size: 1.6rem; font-weight: 700; color: var(--black); border-bottom: 3px solid var(--orange);">0422 553 675</a>
          </p>
          <p style="color: var(--grey); margin-top: 6px;">Monday – Saturday, 7am – 7pm</p>
        </div>

        <!-- ====== LIVE REVIEWS SECTION ====== -->
        <div style="margin-top: 40px; padding-top: 32px; border-top: 2px solid var(--grey-light);">
          <h3>What our customers say</h3>
          <div id="reviewStats" class="review-stats">
            <!-- Static fallback data – will be updated by JavaScript -->
            <div class="stat">
              <span class="stars">★★★★★</span>
            </div>
            <div class="stat">
              <span class="num" id="ratingDisplay">4.9</span>
              <span>average</span>
            </div>
            <div class="stat">
              <span class="num" id="countDisplay">98</span>
              <span>reviews</span>
            </div>
            <span class="source">from Google</span>
          </div>
          <p style="color: var(--grey); font-size: 0.9rem; margin-top: 4px;">
            <a href="https://www.google.com/search?q=antigravity+removals" target="_blank" rel="noopener" style="color: var(--orange); text-decoration: underline;">
              Read all reviews on Google →
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% include "footer.njk" %}


<script>
// ============================================================
// 1. FORM HANDLING – client-side validation & submission
// ============================================================

const form = document.getElementById('quoteForm');
const successDiv = document.getElementById('formSuccess');
const errorDiv = document.getElementById('formError');

if (form) {
  form.addEventListener('submit', function(e) {
    // Hide any previous messages
    successDiv.classList.remove('is-visible');
    errorDiv.classList.remove('is-visible');

    // Basic validation
    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const service = document.getElementById('service').value;
    const message = document.getElementById('message').value.trim();

    if (!name || !email || !service || !message) {
      errorDiv.textContent = '❌ Please fill in all required fields (*).';
      errorDiv.classList.add('is-visible');
      e.preventDefault();
      return;
    }

    // Simple email validation
    if (!email.includes('@') || !email.includes('.')) {
      errorDiv.textContent = '❌ Please enter a valid email address.';
      errorDiv.classList.add('is-visible');
      e.preventDefault();
      return;
    }

    // If using Web3Forms, we let the native submit go through
    // If you want AJAX submission instead, add code here
    // For now: show a "sending" state if needed
    const btn = form.querySelector('button[type="submit"]');
    btn.textContent = '⏳ Sending...';
    btn.disabled = true;

    // Re-enable after a timeout (in case of error)
    setTimeout(() => {
      btn.textContent = 'Send Quote Request →';
      btn.disabled = false;
    }, 5000);
  });
}

