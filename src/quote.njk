---
permalink: /quote/index.html
title: "Get a Quote | Antigravity Logistics"
description: "Request a free quote for transport, heavy handling, residential moves, medical equipment relocation, and disposal services across Sydney and NSW."
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}

  <style>
    /* ==========================================================================
       Quote page — self-contained styles
       ========================================================================== */

    .quote-layout {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 56px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .quote-layout { grid-template-columns: 1fr; gap: 40px; }
    }

    /* ---- Form submit button ---------------------------------------- */

    .quote-submit {
      width: 100%;
      text-align: center;
      font-size: 1.2rem;
      padding: 18px 30px;
      margin-top: 8px;
    }

    .quote-submit:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }

    .quote-note {
      font-size: 0.8rem;
      color: var(--grey);
      margin: 12px 0 0;
      text-align: center;
      max-width: 100%;
    }

    /* ---- Info column ----------------------------------------------- */

    .info-block {
      margin-bottom: 40px;
    }

    .info-block h2 {
      font-size: 1.6rem;
      margin-bottom: 24px;
    }

    /* Numbered steps */

    .next-steps {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .next-step {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 18px 20px;
      background: var(--white);
      border: 1px solid var(--grey-light);
      border-radius: 10px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .next-step:hover {
      border-color: var(--orange);
      transform: translateX(3px);
    }

    .next-step-num {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--black);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-head);
      font-weight: 800;
      font-size: 1rem;
      flex-shrink: 0;
    }

    .next-step:hover .next-step-num {
      background: var(--orange);
    }

    .next-step p {
      margin: 0;
      font-size: 1rem;
      color: var(--black);
      line-height: 1.5;
      max-width: 100%;
    }

    /* Prefer to call card */

    .call-card {
      padding: 24px 26px;
      background: var(--off-white);
      border-left: 4px solid var(--orange);
      border-radius: 0 10px 10px 0;
    }

    .call-card h3 {
      font-size: 1.15rem;
      margin: 0 0 10px;
    }

    .call-card a {
      display: inline-block;
      font-family: var(--font-head);
      font-size: 1.7rem;
      font-weight: 700;
      color: var(--black);
      border-bottom: 3px solid var(--orange);
      padding-bottom: 2px;
      transition: color 0.2s ease;
    }

    .call-card a:hover {
      color: var(--orange);
    }

    .call-card .hours {
      color: var(--grey);
      font-size: 0.9rem;
      margin: 10px 0 0;
    }

    /* ---- Reviews summary ------------------------------------------ */

    .reviews-summary {
      padding-top: 32px;
      border-top: 2px solid var(--grey-light);
    }

    .reviews-summary h3 {
      font-size: 1.15rem;
      margin: 0 0 16px;
    }

    /* Stars */

    .review-stars {
      display: flex;
      gap: 3px;
      color: #f5b342;
      font-size: 1.5rem;
      line-height: 1;
      letter-spacing: 1px;
      margin-bottom: 10px;
    }

    /* Rating number + source */

    .review-rating {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
    }

    .review-rating .rating-num {
      font-family: var(--font-head);
      font-weight: 800;
      font-size: 2.4rem;
      line-height: 1;
      color: var(--orange);
      letter-spacing: 0.5px;
    }

    .review-rating .rating-out {
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 1.2rem;
      color: var(--grey);
    }

    .review-rating .rating-source {
      font-family: var(--font-body);
      font-size: 0.85rem;
      color: var(--grey);
      margin-left: 4px;
    }

    /* Caption + link */

    .rating-caption {
      font-size: 0.95rem;
      color: #4d4d4f;
      margin: 0 0 14px;
      max-width: 100%;
    }

    .reviews-summary .read-link {
      color: var(--orange);
      font-size: 0.9rem;
      text-decoration: underline;
    }

    .reviews-summary .read-link:hover { color: var(--orange-dark); }

    /* Success / error messages use the existing .form-success / .form-error
       styles defined in css/style.css */

    @media (max-width: 480px) {
      .call-card a { font-size: 1.4rem; }
      .review-stars { font-size: 1.25rem; }
      .review-rating .rating-num { font-size: 2rem; }
      .review-rating .rating-out { font-size: 1.05rem; }
      .review-rating .rating-source { font-size: 0.8rem; }
    }
  </style>
</head>
<body>

{% include "header.njk" %}

<!-- ====== PAGE HEADER ====== -->

<section class="page-header">
  <div class="wrap">
    <div class="hero-eyebrow">Get a Quote</div>
    <h1>Tell us what you need moved</h1>
    <p class="lead" style="margin-top:16px;">Fill in the form below and we'll get back to you within 24 hours with a clear plan and price.</p>
  </div>
</section>

<div class="bar-divider"></div>

<!-- ====== QUOTE FORM + INFO ====== -->

<section class="section">
  <div class="wrap">
    <div class="quote-layout">

      <!-- FORM COLUMN -->
      <div>
        <!-- Success / Error messages -->
        <div id="formSuccess" class="form-success">
          <strong>✅ Thank you!</strong> Your quote request has been sent. We'll get back to you within 24 hours.
        </div>
        <div id="formError" class="form-error">
          <strong>❌ Something went wrong.</strong> Please try again or contact us directly by phone.
        </div>

        <form id="quoteForm" action="https://api.web3forms.com/submit" method="POST">
          <!-- Replace with your Web3Forms access key -->
          <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE">

          <!-- Bot protection (honeypot) -->
          <input type="checkbox" name="botcheck" style="display: none;">

          <!-- Email subject line -->
          <input type="hidden" name="subject" value="New Quote Request from Antigravity Logistics">

          <!-- Service -->
          <div class="form-group">
            <label for="service">What service do you need? *</label>
            <select id="service" name="service" required>
              <option value="">— Please select —</option>
              <option value="Transport & Logistics">Transport &amp; Logistics</option>
              <option value="Heavy Handling">Heavy Handling</option>
              <option value="Hospital & Medical Equipment">Hospital &amp; Medical Equipment</option>
              <option value="Residential Move">Residential Move</option>
              <option value="Disposal & Removal">Disposal &amp; Removal</option>
              <option value="Other / Not sure">Other / Not sure</option>
            </select>
          </div>

          <!-- Name + Email -->
          <div class="form-row">
            <div class="form-group">
              <label for="name">Your name *</label>
              <input type="text" id="name" name="name" placeholder="John Smith" required>
            </div>
            <div class="form-group">
              <label for="email">Email address *</label>
              <input type="email" id="email" name="email" placeholder="john@example.com" required>
            </div>
          </div>

          <!-- Phone -->
          <div class="form-group">
            <label for="phone">Phone number</label>
            <input type="tel" id="phone" name="phone" placeholder="0422 553 675">
          </div>

          <!-- Job details -->
          <div class="form-group">
            <label for="message">Tell us about your job *</label>
            <textarea id="message" name="message" placeholder="What needs to be moved? Where from and to? Any stairs, tight access, or oversized items?" required></textarea>
          </div>

          <!-- Locations -->
          <div class="form-row">
            <div class="form-group">
              <label for="pickup">Pickup suburb / postcode</label>
              <input type="text" id="pickup" name="pickup" placeholder="e.g. Sydney, 2000">
            </div>
            <div class="form-group">
              <label for="delivery">Delivery suburb / postcode</label>
              <input type="text" id="delivery" name="delivery" placeholder="e.g. Parramatta, 2150">
            </div>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn quote-submit">Send Quote Request →</button>

          <p class="quote-note">We'll respond within 24 hours. Your details are safe with us.</p>
        </form>
      </div>

      <!-- INFO COLUMN -->
      <div>

        <!-- What happens next -->
        <div class="info-block">
          <h2>What happens next</h2>
          <ol class="next-steps">
            <li class="next-step">
              <span class="next-step-num">1</span>
              <p>We receive your request and review the details.</p>
            </li>
            <li class="next-step">
              <span class="next-step-num">2</span>
              <p>We ask any follow-up questions if needed.</p>
            </li>
            <li class="next-step">
              <span class="next-step-num">3</span>
              <p>We send you a custom plan and a clear price.</p>
            </li>
            <li class="next-step">
              <span class="next-step-num">4</span>
              <p>We lock in a date and get the job done.</p>
            </li>
          </ol>
        </div>

        <!-- Prefer to call -->
        <div class="info-block">
          <div class="call-card">
            <h3>Prefer to call?</h3>
            <a href="tel:+61422553675">0422 553 675</a>
            <p class="hours">Monday – Saturday, 7am – 7pm</p>
          </div>
        </div>

        <!-- Reviews summary -->
        <div class="reviews-summary">
          <h3>What our customers say</h3>
          <div class="review-stars" aria-label="Rated 4.8 or higher out of 5">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <div class="review-rating">
            <span class="rating-num">4.8+</span>
            <span class="rating-out">/ 5</span>
            <span class="rating-source">from Google</span>
          </div>
          <p class="rating-caption">Highly rated by customers across Sydney and NSW.</p>
          <a href="https://www.google.com/search?q=antigravity+removals" target="_blank" rel="noopener" class="read-link">
            Read reviews on Google →
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

{% include "footer.njk" %}

<script>
// ============================================================
// Form validation
// ============================================================

const form = document.getElementById('quoteForm');
const successDiv = document.getElementById('formSuccess');
const errorDiv = document.getElementById('formError');

if (form) {
  form.addEventListener('submit', function(e) {
    successDiv.classList.remove('is-visible');
    errorDiv.classList.remove('is-visible');

    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const service = document.getElementById('service').value;
    const message = document.getElementById('message').value.trim();

    if (!name || !email || !service || !message) {
      errorDiv.textContent = '❌ Please fill in all required fields (*).';
      errorDiv.classList.add('is-visible');
      e.preventDefault();
      return;
    }

    if (!email.includes('@') || !email.includes('.')) {
      errorDiv.textContent = '❌ Please enter a valid email address.';
      errorDiv.classList.add('is-visible');
      e.preventDefault();
      return;
    }

    const btn = form.querySelector('button[type="submit"]');
    btn.textContent = '⏳ Sending...';
    btn.disabled = true;

    setTimeout(() => {
      btn.textContent = 'Send Quote Request →';
      btn.disabled = false;
    }, 5000);
  });
}
</script>

</body>
</html>