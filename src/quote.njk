---
permalink: /quote/index.html
title: "Get a Quote | Antigravity Logistics"
description: "Request a free quote for residential removals, commercial relocations, transport, heavy handling and disposal across Sydney and NSW."
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}

  <style>
    /* ==========================================================================
       Quote page — self-contained styles
       ========================================================================== */

    .quote-layout {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 56px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .quote-layout { grid-template-columns: 1fr; gap: 40px; }
    }

    .quote-submit {
      width: 100%;
      text-align: center;
      font-size: 1.2rem;
      padding: 18px 30px;
      margin-top: 8px;
    }

    .quote-submit:disabled { opacity: 0.7; cursor: not-allowed; }

    .quote-note {
      font-size: 0.8rem;
      color: var(--grey);
      margin: 12px 0 0;
      text-align: center;
      max-width: 100%;
    }

    /* ---- Optional details — collapsible section ------------------- */

    .optional-section {
      margin: 28px 0 8px;
      border: 1px solid var(--grey-light);
      border-radius: 12px;
      background: var(--white);
      overflow: hidden;
      transition: border-color 0.25s ease;
    }

    .optional-section[open] {
      border-color: var(--orange);
    }

    .optional-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 16px 20px;
      cursor: pointer;
      list-style: none;
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 1rem;
      color: var(--black);
      letter-spacing: 0.2px;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .optional-toggle::-webkit-details-marker { display: none; }

    .optional-toggle:hover {
      color: var(--orange);
      background: rgba(255, 80, 51, 0.04);
    }

    .optional-section[open] .optional-toggle {
      color: var(--orange);
      border-bottom: 1px solid var(--grey-light);
    }

    .optional-toggle-text {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .optional-toggle-text .optional-icon {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      color: var(--orange);
    }

    .optional-toggle .optional-hint {
      font-family: var(--font-body);
      font-weight: 400;
      font-size: 0.82rem;
      color: var(--grey);
      letter-spacing: 0;
      margin-left: 4px;
    }

    .optional-section[open] .optional-toggle .optional-hint {
      display: none;
    }

    .optional-chevron {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      transition: transform 0.3s ease;
      color: var(--orange);
    }

    .optional-section[open] .optional-chevron {
      transform: rotate(180deg);
    }

    .optional-body {
      padding: 24px 20px 20px;
    }

    @media (max-width: 480px) {
      .optional-toggle { padding: 14px 16px; font-size: 0.95rem; }
      .optional-body { padding: 20px 16px 16px; }
    }

    /* ---- Checkbox pills ------------------------------------------ */

    .checkbox-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 4px;
    }

    .checkbox-pill {
      display: inline-flex;
      align-items: center;
      padding: 10px 18px;
      background: var(--white);
      border: 2px solid var(--grey-light);
      border-radius: 999px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
      user-select: none;
      color: var(--black);
    }

    .checkbox-pill:hover {
      border-color: var(--orange);
    }

    .checkbox-pill input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .checkbox-pill:has(input:checked) {
      border-color: var(--orange);
      background: rgba(255, 80, 51, 0.08);
      color: var(--orange);
    }

    .checkbox-pill:has(input:focus-visible) {
      outline: 3px solid var(--orange);
      outline-offset: 2px;
    }

    /* ---- Info column ---------------------------------------------- */

    .info-block { margin-bottom: 40px; }

    .info-block h2 {
      font-size: 1.6rem;
      margin-bottom: 28px;
    }

    .next-steps {
      list-style: none;
      padding: 0;
      margin: 0;
      position: relative;
    }

    .next-steps::before {
      content: '';
      position: absolute;
      left: 17px;
      top: 20px;
      bottom: 20px;
      width: 2px;
      background: repeating-linear-gradient(
        to bottom,
        var(--orange) 0,
        var(--orange) 5px,
        transparent 5px,
        transparent 12px
      );
      opacity: 0.5;
      z-index: 0;
    }

    .next-step {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      padding: 0 0 24px;
      position: relative;
      z-index: 1;
    }

    .next-step:last-child { padding-bottom: 0; }

    .next-step-num {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--white);
      border: 3px solid var(--orange);
      color: var(--orange);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-head);
      font-weight: 800;
      font-size: 1rem;
      flex-shrink: 0;
      transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
    }

    .next-step:hover .next-step-num {
      background: var(--orange);
      color: var(--white);
      transform: scale(1.1);
    }

    .next-step p {
      margin: 6px 0 0;
      font-size: 1rem;
      color: var(--black);
      line-height: 1.5;
      max-width: 100%;
    }

    .call-card {
      padding: 26px 28px;
      background: linear-gradient(135deg, var(--off-white) 0%, #f0efec 100%);
      border-left: 4px solid var(--orange);
      border-radius: 0 12px 12px 0;
      position: relative;
      overflow: hidden;
    }

    .call-card::after {
      content: '';
      position: absolute;
      right: -40px;
      bottom: -40px;
      width: 140px;
      height: 140px;
      background: var(--orange);
      opacity: 0.06;
      border-radius: 50%;
      pointer-events: none;
    }

    .call-card h3 {
      font-size: 1.15rem;
      margin: 0 0 10px;
    }

    .call-card a {
      display: inline-block;
      font-family: var(--font-head);
      font-size: 1.7rem;
      font-weight: 700;
      color: var(--black);
      border-bottom: 3px solid var(--orange);
      padding-bottom: 2px;
      transition: color 0.2s ease;
      position: relative;
      z-index: 1;
    }

    .call-card a:hover { color: var(--orange); }

    .call-card .hours {
      color: var(--grey);
      font-size: 0.9rem;
      margin: 10px 0 0;
      position: relative;
      z-index: 1;
    }

    .reviews-summary {
      padding: 28px 26px;
      background: linear-gradient(135deg, #1e1f22 0%, #26282c 100%);
      border-left: 4px solid var(--orange);
      border-radius: 0 12px 12px 0;
      color: var(--white);
      position: relative;
      overflow: hidden;
    }

    .reviews-summary::after {
      content: '';
      position: absolute;
      right: -60px;
      top: -60px;
      width: 180px;
      height: 180px;
      background: var(--orange);
      opacity: 0.08;
      border-radius: 50%;
      pointer-events: none;
    }

    .reviews-summary h3 {
      font-family: var(--font-head);
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--white);
      margin: 0 0 16px;
      position: relative;
      z-index: 1;
    }

    .review-stars {
      display: flex;
      gap: 3px;
      color: #f5b342;
      font-size: 1.5rem;
      line-height: 1;
      letter-spacing: 1px;
      margin-bottom: 10px;
      position: relative;
      z-index: 1;
    }

    .review-rating {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
      position: relative;
      z-index: 1;
    }

    .review-rating .rating-num {
      font-family: var(--font-head);
      font-weight: 800;
      font-size: 2.4rem;
      line-height: 1;
      color: var(--orange);
      letter-spacing: 0.5px;
    }

    .review-rating .rating-out {
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 1.2rem;
      color: #9a9a9d;
    }

    .review-rating .rating-source {
      font-family: var(--font-body);
      font-size: 0.85rem;
      color: #9a9a9d;
      margin-left: 4px;
    }

    .rating-caption {
      font-size: 0.95rem;
      color: #cfcfd1;
      margin: 0 0 14px;
      max-width: 100%;
      position: relative;
      z-index: 1;
    }

    .reviews-summary .read-link {
      color: var(--orange);
      font-size: 0.9rem;
      text-decoration: underline;
      position: relative;
      z-index: 1;
    }

    .reviews-summary .read-link:hover { color: var(--white); }

    /* ---- Confirmation modal --------------------------------------- */

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 16, 17, 0.65);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      z-index: 9999;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    .modal-backdrop.is-open {
      opacity: 1;
      visibility: visible;
    }

    .modal-card {
      background: var(--white);
      border-radius: 16px;
      max-width: 560px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      padding: 40px 36px 32px;
      position: relative;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
      transform: translateY(12px) scale(0.98);
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .modal-backdrop.is-open .modal-card {
      transform: translateY(0) scale(1);
    }

    @media (max-width: 480px) {
      .modal-card { padding: 32px 24px 26px; }
    }

    .modal-close {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--off-white);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--black);
      transition: background 0.2s ease, color 0.2s ease;
    }

    .modal-close:hover {
      background: var(--orange);
      color: var(--white);
    }

    .modal-close svg { width: 18px; height: 18px; }

    .modal-icon {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--orange);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }

    .modal-icon svg { width: 28px; height: 28px; }

    .modal-card h2 {
      font-size: 1.6rem;
      margin: 0 0 8px;
      color: var(--black);
    }

    .modal-card > p {
      color: #4d4d4f;
      margin: 0 0 24px;
      font-size: 1rem;
      max-width: 100%;
    }

    .modal-summary {
      background: var(--off-white);
      border-radius: 12px;
      padding: 20px 22px;
      margin: 0 0 24px;
      font-size: 0.92rem;
    }

    .modal-summary dl {
      margin: 0;
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 10px 16px;
      max-width: 100%;
    }

    .modal-summary dt {
      color: var(--grey);
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      align-self: center;
    }

    .modal-summary dd {
      margin: 0;
      color: var(--black);
      font-weight: 500;
      word-break: break-word;
    }

    @media (max-width: 480px) {
      .modal-summary dl { grid-template-columns: 1fr; gap: 4px 0; }
      .modal-summary dt { margin-top: 8px; }
    }

    .modal-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .modal-actions .btn {
      flex: 1;
      text-align: center;
      min-width: 130px;
    }

    .btn--ghost-dark {
      background: transparent;
      color: var(--black);
      border: 2px solid var(--grey-light);
    }

    .btn--ghost-dark:hover,
    .btn--ghost-dark:focus-visible {
      background: var(--off-white);
      color: var(--black);
      border-color: var(--black);
    }

    .modal-contact {
      list-style: none;
      padding: 0;
      margin: 0 0 24px;
    }

    .modal-contact li {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      background: var(--off-white);
      border-radius: 10px;
      margin-bottom: 10px;
      font-size: 1rem;
    }

    .modal-contact svg {
      width: 20px;
      height: 20px;
      color: var(--orange);
      flex-shrink: 0;
    }

    .modal-contact a {
      color: var(--black);
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .modal-contact a:hover { color: var(--orange); }

    @media (max-width: 480px) {
      .call-card a { font-size: 1.4rem; }
      .review-stars { font-size: 1.25rem; }
      .review-rating .rating-num { font-size: 2rem; }
      .review-rating .rating-out { font-size: 1.05rem; }
      .review-rating .rating-source { font-size: 0.8rem; }
    }
  </style>
</head>
<body>

{% include "header.njk" %}

<section class="page-header">
  <div class="wrap">
    <div class="hero-eyebrow">Get a Quote</div>
    <h1>Tell us what you need moved</h1>
    <p class="lead" style="margin-top:16px;">Fill in the form below and we'll get back to you within 24 hours with a clear plan and price.</p>
  </div>
</section>

<div class="bar-divider"></div>

<section class="section">
  <div class="wrap">
    <div class="quote-layout">

      <!-- FORM COLUMN -->
      <div>
        <div id="formSuccess" class="form-success">
          <strong>✅ Thank you!</strong> Your quote request has been sent. We'll get back to you within 24 hours.
        </div>
        <div id="formError" class="form-error">
          <strong>❌ Something went wrong.</strong> Please try again or contact us directly by phone.
        </div>

        <form id="quoteForm" novalidate>

          <!-- Required fields -->

          <div class="form-group">
            <label for="service">What service do you need? *</label>
            <select id="service" name="service" required>
              <option value="">— Please select —</option>
              <option value="residential">Residential Removals</option>
              <option value="commercial">Commercial Removals</option>
              <option value="transport">Transport &amp; Logistics</option>
              <option value="heavy-handling">Heavy &amp; Specialised Handling</option>
              <option value="disposal">Removal &amp; Disposal</option>
              <option value="other">Other / Not sure</option>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="name">Your name *</label>
              <input type="text" id="name" name="name" placeholder="John Smith" required>
            </div>
            <div class="form-group">
              <label for="email">Email address *</label>
              <input type="email" id="email" name="email" placeholder="john@example.com" required>
            </div>
          </div>

          <div class="form-group">
            <label for="phone">Phone number</label>
            <input type="tel" id="phone" name="phone" placeholder="0422 553 675">
          </div>

          <div class="form-group">
            <label for="message">Tell us about your job *</label>
            <textarea id="message" name="message" placeholder="What needs to be moved? Where from and to? Any stairs, tight access, or oversized items?" required></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="pickup">Pickup suburb / postcode</label>
              <input type="text" id="pickup" name="pickup" placeholder="e.g. Sydney, 2000">
            </div>
            <div class="form-group">
              <label for="delivery">Delivery suburb / postcode</label>
              <input type="text" id="delivery" name="delivery" placeholder="e.g. Parramatta, 2150">
            </div>
          </div>

          <!-- Optional details — collapsible -->

          <details class="optional-section" id="optionalDetails">
            <summary class="optional-toggle">
              <span class="optional-toggle-text">
                <svg class="optional-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                Optional details
                <span class="optional-hint">— helps us quote more accurately</span>
              </span>
              <svg class="optional-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>

            <div class="optional-body">

              <div class="form-row">
                <div class="form-group">
                  <label for="date">Preferred date</label>
                  <input type="date" id="date" name="date">
                </div>
                <div class="form-group">
                  <label for="time">Preferred time window</label>
                  <select id="time" name="time">
                    <option value="">Any time</option>
                    <option value="morning">Morning (7am–12pm)</option>
                    <option value="afternoon">Afternoon (12pm–5pm)</option>
                    <option value="evening">Evening (after 5pm)</option>
                    <option value="flexible">Flexible</option>
                  </select>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="volume">Estimated size</label>
                  <select id="volume" name="volume">
                    <option value="">— Not sure —</option>
                    <option value="single-item">Single item</option>
                    <option value="small">Small (studio / 1 bedroom)</option>
                    <option value="medium">Medium (2–3 bedrooms)</option>
                    <option value="large">Large (4+ bedrooms)</option>
                    <option value="office">Office / commercial</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="floor">Floor / level</label>
                  <input type="text" id="floor" name="floor" placeholder="e.g. 2nd floor, ground">
                </div>
              </div>

              <div class="form-group">
                <label>Access details</label>
                <div class="checkbox-row">
                  <label class="checkbox-pill"><input type="checkbox" name="access" value="stairs"><span>Stairs</span></label>
                  <label class="checkbox-pill"><input type="checkbox" name="access" value="no-elevator"><span>No elevator</span></label>
                  <label class="checkbox-pill"><input type="checkbox" name="access" value="tight-access"><span>Tight access</span></label>
                  <label class="checkbox-pill"><input type="checkbox" name="access" value="long-carry"><span>Long carry</span></label>
                  <label class="checkbox-pill"><input type="checkbox" name="access" value="parking"><span>Parking restrictions</span></label>
                </div>
              </div>

              <div class="form-group">
                <label>Services needed</label>
                <div class="checkbox-row">
                  <label class="checkbox-pill"><input type="checkbox" name="extras" value="packing"><span>Packing help</span></label>
                  <label class="checkbox-pill"><input type="checkbox" name="extras" value="assembly"><span>Assembly / disassembly</span></label>
                  <label class="checkbox-pill"><input type="checkbox" name="extras" value="disposal"><span>Disposal</span></label>
                  <label class="checkbox-pill"><input type="checkbox" name="extras" value="storage"><span>Storage</span></label>
                  <label class="checkbox-pill"><input type="checkbox" name="extras" value="fragile"><span>Fragile items</span></label>
                </div>
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label for="notes">Anything else we should know?</label>
                <textarea id="notes" name="notes" placeholder="Special requirements, preferred contact method, unusual items, parking notes…" style="min-height: 90px;"></textarea>
              </div>

            </div>
          </details>

          <button type="submit" class="btn quote-submit">Send Quote Request →</button>

          <p class="quote-note">We'll respond within 24 hours. Your details are safe with us.</p>
        </form>
      </div>

      <!-- INFO COLUMN -->
      <div>

        <div class="info-block">
          <h2>What happens next</h2>
          <ol class="next-steps">
            <li class="next-step">
              <span class="next-step-num">1</span>
              <p>We receive your request and review the details.</p>
            </li>
            <li class="next-step">
              <span class="next-step-num">2</span>
              <p>We ask any follow-up questions if needed.</p>
            </li>
            <li class="next-step">
              <span class="next-step-num">3</span>
              <p>We send you a custom plan and a clear price.</p>
            </li>
            <li class="next-step">
              <span class="next-step-num">4</span>
              <p>We lock in a date and get the job done.</p>
            </li>
          </ol>
        </div>

        <div class="info-block">
          <div class="call-card">
            <h3>Prefer to call?</h3>
            <a href="tel:+61422553675">0422 553 675</a>
            <p class="hours">Monday – Saturday, 7am – 7pm</p>
          </div>
        </div>

        <div class="reviews-summary">
          <h3>What our customers say</h3>
          <div class="review-stars" aria-label="Rated 5 out of 5">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <div class="review-rating">
            <span class="rating-num">5</span>
            <span class="rating-out">/ 5</span>
            <span class="rating-source">from Google</span>
          </div>
          <p class="rating-caption">Highly rated by customers across Sydney and NSW.</p>
          <a href="https://www.google.com/search?q=antigravity+removals" target="_blank" rel="noopener" class="read-link">
            Read reviews on Google →
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

{% include "footer.njk" %}

<!-- ====== CONFIRMATION MODAL ====== -->

<div class="modal-backdrop" id="confirmModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-card">

    <button type="button" class="modal-close" aria-label="Close" data-action="cancel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <!-- Step 1: Confirm -->
    <div class="modal-step" data-step="confirm">
      <div class="modal-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h2 id="modalTitle">Ready to send?</h2>
      <p>Please review your details before sending us your quote request.</p>

      <div class="modal-summary">
        <dl id="modalSummary"></dl>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn--ghost-dark" data-action="cancel">Go back</button>
        <button type="button" class="btn" data-action="confirm">Confirm &amp; send →</button>
      </div>
    </div>

    <!-- Step 2: Not configured -->
    <div class="modal-step" data-step="done" hidden>
      <div class="modal-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <h2>Almost there</h2>
      <p>This form isn't connected to a backend yet, so we couldn't send it automatically. Please contact us directly to finish your request — we usually reply within a few hours.</p>

      <ul class="modal-contact">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <a href="tel:+61422553675">0422 553 675</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7 10-7"/></svg>
          <a href="mailto:antigravitylogistics@gmail.com">antigravitylogistics@gmail.com</a>
        </li>
      </ul>

      <div class="modal-actions">
        <button type="button" class="btn" data-action="cancel" style="width:100%;">Got it</button>
      </div>
    </div>

  </div>
</div>

<script>
// ============================================================
// 1. Pre-select service from URL (?service=transport)
// ============================================================

(function () {
  var params = new URLSearchParams(window.location.search);
  var serviceParam = params.get('service');
  if (!serviceParam) return;

  var select = document.getElementById('service');
  if (!select) return;

  for (var i = 0; i < select.options.length; i++) {
    if (select.options[i].value === serviceParam) {
      select.selectedIndex = i;
      select.style.transition = 'box-shadow 0.4s ease';
      select.style.boxShadow = '0 0 0 4px rgba(255, 80, 51, 0.25)';
      setTimeout(function () { select.style.boxShadow = 'none'; }, 1400);
      break;
    }
  }
})();

// ============================================================
// 2. Auto-open optional section if it has values from URL
//    (nice-to-have — future-proofing for pre-filled links)
// ============================================================

(function () {
  var params = new URLSearchParams(window.location.search);
  var optionalKeys = ['date', 'time', 'volume', 'floor', 'access', 'extras'];
  var hasOptional = optionalKeys.some(function (k) { return params.has(k); });

  if (hasOptional) {
    var details = document.getElementById('optionalDetails');
    if (details) details.open = true;
  }
})();

// ============================================================
// 3. Form → confirmation modal → "not configured" message
// ============================================================

(function () {
  var form = document.getElementById('quoteForm');
  var modal = document.getElementById('confirmModal');
  var summary = document.getElementById('modalSummary');
  var stepConfirm = modal.querySelector('[data-step="confirm"]');
  var stepDone = modal.querySelector('[data-step="done"]');
  var successDiv = document.getElementById('formSuccess');
  var errorDiv = document.getElementById('formError');

  if (!form || !modal) return;

  function openModal() {
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    stepConfirm.hidden = false;
    stepDone.hidden = true;
  }

  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function buildSummary() {
    var serviceSelect = document.getElementById('service');
    var serviceText = serviceSelect.options[serviceSelect.selectedIndex].text;

    var access = [];
    document.querySelectorAll('input[name="access"]:checked').forEach(function (cb) {
      access.push(cb.parentElement.textContent.trim());
    });

    var extras = [];
    document.querySelectorAll('input[name="extras"]:checked').forEach(function (cb) {
      extras.push(cb.parentElement.textContent.trim());
    });

    var dateVal = document.getElementById('date').value || '—';
    var timeVal = document.getElementById('time').value || '—';
    var volumeVal = document.getElementById('volume').value || '—';
    var floorVal = document.getElementById('floor').value.trim() || '—';

    var rows = [
      ['Service', serviceText],
      ['Name', document.getElementById('name').value.trim() || '—'],
      ['Email', document.getElementById('email').value.trim() || '—'],
      ['Phone', document.getElementById('phone').value.trim() || '—'],
      ['Pickup', document.getElementById('pickup').value.trim() || '—'],
      ['Delivery', document.getElementById('delivery').value.trim() || '—'],
      ['Preferred date', dateVal],
      ['Time window', timeVal],
      ['Estimated size', volumeVal],
      ['Floor / level', floorVal],
      ['Access', access.length ? access.join(', ') : '—'],
      ['Extras', extras.length ? extras.join(', ') : '—']
    ];

    summary.innerHTML = rows.map(function (row) {
      return '<dt>' + row[0] + '</dt><dd>' + row[1] + '</dd>';
    }).join('');
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    successDiv.classList.remove('is-visible');
    errorDiv.classList.remove('is-visible');

    var name = document.getElementById('name').value.trim();
    var email = document.getElementById('email').value.trim();
    var service = document.getElementById('service').value;
    var message = document.getElementById('message').value.trim();

    if (!name || !email || !service || !message) {
      errorDiv.textContent = '❌ Please fill in all required fields (*).';
      errorDiv.classList.add('is-visible');
      errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    if (!email.includes('@') || !email.includes('.')) {
      errorDiv.textContent = '❌ Please enter a valid email address.';
      errorDiv.classList.add('is-visible');
      errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    buildSummary();
    openModal();
  });

  // Modal actions

  modal.addEventListener('click', function (e) {
    var action = e.target.getAttribute('data-action');
    if (!action) return;

    if (action === 'cancel') {
      closeModal();
    } else if (action === 'confirm') {
      stepConfirm.hidden = true;
      stepDone.hidden = false;
    }
  });

  // Close on backdrop click

  modal.addEventListener('click', function (e) {
    if (e.target === modal) closeModal();
  });

  // Close on Escape

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) {
      closeModal();
    }
  });
})();
</script>

</body>
</html>