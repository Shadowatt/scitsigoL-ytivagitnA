      <div class="service-card reveal">
        <div class="service-icon"><img src="{{ '/images/icon-medical.svg' | url }}" alt="" loading="lazy"></div>
        <h3>Hospital &amp; Medical</h3>
        <p>Careful transport, relocation and positioning of hospital and medical equipment for facilities.</p>
        <a href="{{ '/services/' | url }}" class="tile-link">Learn more →</a>
      </div>

      <div class="service-card reveal">
        <div class="service-icon"><img src="{{ '/images/icon-residential.svg' | url }}" alt="" loading="lazy"></div>
        <h3>Residential Moves</h3>
        <p>Professional house and apartment moves, including packing and heavy-item handling.</p>
        <a href="{{ '/services/' | url }}" class="tile-link">Learn more →</a>
      </div>

      <div class="service-card reveal">
        <div class="service-icon"><img src="{{ '/images/icon-disposal.svg' | url }}" alt="" loading="lazy"></div>
        <h3>Disposal &amp; Removal</h3>
        <p>Removal and disposal of unwanted furniture, equipment and general rubbish.</p>
        <a href="{{ '/services/' | url }}" class="tile-link">Learn more →</a>
      </div>

    </div>
  </div>
</section>

<!-- ====== HOW IT WORKS — timeline ====== -->

<section class="section">
  <div class="wrap">
    <h2 class="reveal">How It Works</h2>
    <p class="reveal" style="max-width:52ch;">A simple, four-step process from first contact to job done.</p>
    <div class="steps reveal-group">
      <div class="step reveal">
        <span class="step-num">1</span>
        <div>
          <h3>Get in touch</h3>
          <p>Call, email or message us with a few details about the job.</p>
        </div>
      </div>
      <div class="step reveal">
        <span class="step-num">2</span>
        <div>
          <h3>Get a quote</h3>
          <p>We ask a few questions and come back with a straight answer on price.</p>
        </div>
      </div>
      <div class="step reveal">
        <span class="step-num">3</span>
        <div>
          <h3>Schedule</h3>
          <p>We lock in a date and time that works for you.</p>
        </div>
      </div>
      <div class="step reveal">
        <span class="step-num">4</span>
        <div>
          <h3>Job done</h3>
          <p>Our team handles it professionally, start to finish.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ====== QUOTE BAND ====== -->

<section class="quote-band">
  <div class="wrap">
    <div class="quote-band-content">
      <div class="quote-band-text reveal">
        <span class="quote-band-eyebrow">Free, no-obligation</span>
        <h2>Get a quote in 2 minutes</h2>
        <p>Tell us what needs moving and we'll come back with a clear plan and a straight answer on price — usually within 24 hours.</p>
      </div>
      <div class="reveal">
        <a href="{{ '/quote/' | url }}" class="btn">Get a Quote →</a>
      </div>
    </div>
  </div>
</section>

<!-- ====== REVIEWS ====== -->

<section class="section section--darker">
  <div class="wrap">
    <h2 class="reveal">What Our Customers Say</h2>
    <p class="reviews-sub reveal">Rated 5/5 by customers across Sydney and NSW.</p>

    <div class="reviews-grid reveal-group">

      <div class="review-card reveal">
        <span class="review-badge">Google</span>
        <span class="quote-mark">&ldquo;</span>
        <div class="review-stars"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></div>
