<!DOCTYPE html>
<html class="no-js" lang="en">
<head>
  {% include "head.njk" %}

  <style>
    /* ==========================================================================
       Homepage — self-contained styles
       ========================================================================== */

    /* ---- Hero — CTA row with quote button prominent ---- */

    .hero .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
    }

    /* ---- Quote band — conversion push after "How It Works" ---- */

    .quote-band {
      background: linear-gradient(135deg, var(--black) 0%, #1a1b1d 100%);
      padding: 80px 0;
      position: relative;
      overflow: hidden;
    }

    .quote-band::before {
      content: '';
      position: absolute;
      right: -100px;
      top: -100px;
      width: 380px;
      height: 380px;
      background: var(--orange);
      opacity: 0.07;
      transform: rotate(45deg);
      pointer-events: none;
    }

    .quote-band::after {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 6px;
      height: 100%;
      background: var(--orange);
    }

    .quote-band-content {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 56px;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 800px) {
      .quote-band-content {
        grid-template-columns: 1fr;
        gap: 32px;
      }
    }

    .quote-band-eyebrow {
      display: inline-block;
      color: var(--orange);
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 14px;
    }

    .quote-band-text h2 {
      color: var(--white);
      margin-bottom: 12px;
      max-width: 22ch;
    }

    .quote-band-text p {
      color: #cfcfd1;
      margin: 0;
      max-width: 52ch;
      font-size: 1.05rem;
    }

    .quote-band .btn {
      padding: 18px 38px;
      font-size: 1.15rem;
      white-space: nowrap;
      border-color: var(--orange);
      background: var(--orange);
      color: var(--white);
    }

    .quote-band .btn:hover,
    .quote-band .btn:focus-visible {
      background: transparent;
      color: var(--orange);
    }

    @media (max-width: 480px) {
      .quote-band { padding: 56px 0; }
      .quote-band .btn { padding: 16px 28px; font-size: 1.05rem; }
      .quote-band-text h2 { font-size: 1.8rem; }
    }

    /* ---- Slightly more breathing room for the review subtitle ---- */

    .reviews-sub {
      color: #cfcfd1;
      font-size: 1.05rem;
      margin: 0 0 8px;
      max-width: 52ch;
    }
  </style>
</head>
