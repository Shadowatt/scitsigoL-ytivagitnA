    </div>
  </div>
</section>

<!-- ====== TRUST BAR ====== -->

<section class="trust-bar">
  <div class="wrap">
    <div class="trust-item"><span class="num">✓</span> Fully Insured</div>
    <div class="trust-item"><span class="num">10+</span> Years Industry Experience</div>
    <div class="trust-item"><span class="num">5+</span> Years Serving Sydney</div>
    <div class="trust-item"><span class="num">5★</span> Top-rated by customers</div>
  </div>
</section>

<div class="bar-divider"></div>

<!-- ====== ABOUT SPLIT ====== -->

<section class="section">
  <div class="wrap split">
    <div class="reveal">
      <h2>More than removals. More ways to move.</h2>
      <p>Antigravity Logistics has grown from a residential moving business into a broader transport, logistics and heavy-handling company.</p>
      <p>We provide reliable transport and handling solutions for businesses, organisations, contractors and private customers across Sydney and NSW.</p>

      <a href="{{ '/whats-included/' | url }}" class="tile-link">See what's included →</a>
    </div>
    <div class="media reveal">
      <img src="{{ '/images/photos/2-men-with-long-yellow-item.jpeg' | url }}" alt="Two Antigravity Logistics team members carrying a long heavy item together" loading="lazy" decoding="async">
    </div>
  </div>
</section>

<!-- ====== WHAT WE DO — bento grid ====== -->

<section class="section section--dark">
  <div class="wrap reveal">
    <h2>What We Do</h2>
    <p class="section-intro" style="max-width:56ch;">Five ways we help Sydney and NSW businesses and households keep moving.</p>
  </div>
  <div class="wrap">
    <div class="service-grid reveal-group">

      <div class="service-card reveal">
        <div class="service-icon"><img src="{{ '/images/icon-transport.svg' | url }}" alt="" loading="lazy"></div>
        <h3>Transport &amp; Logistics</h3>
        <p>Reliable transport for furniture, boxes, crates, pallets, commercial goods, equipment and bulky items — across Sydney and NSW, one item or a full load.</p>
        <a href="{{ '/services/' | url }}" class="tile-link">Learn more →</a>
      </div>

      <div class="service-card reveal">
        <div class="service-icon"><img src="{{ '/images/icon-heavy-handling.svg' | url }}" alt="" loading="lazy"></div>
