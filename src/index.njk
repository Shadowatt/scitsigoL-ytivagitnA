    <div class="hero-bg-item" style="--i: 1">
      <img src="{{ '/images/photos/2-men-with-long-yellow-item.jpeg' | url }}" alt="" loading="lazy" decoding="async">
    </div>

    <div class="hero-bg-item" style="--i: 2">
