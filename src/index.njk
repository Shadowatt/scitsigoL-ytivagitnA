    </div>
  </div>
</section>

<!-- ====== BOTTOM CTA ====== -->

<section class="cta-band">
  <div class="wrap">
    <div>
      <h2>Ready to get moving?</h2>
      <p class="subtext">Tell us what you need and we'll get back to you with a plan.</p>
    </div>
    <a href="{{ '/quote/' | url }}" class="btn">Get a Quote</a>
  </div>
</section>

