<!DOCTYPE html>
<html class="no-js" lang="en">
<head>
  {% include "head.njk" %}

  <style>
    /* ==========================================================================
       Homepage — self-contained styles
       ========================================================================== */

    /* ---- Hero with Ken Burns gallery background ---------------------- */

    .hero {
      padding: 140px 0 120px;
      min-height: 620px;
      display: flex;
      align-items: center;
      background: var(--black);
    }

    .hero > .wrap {
      position: relative;
      z-index: 3;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: 1;
      overflow: hidden;
      pointer-events: none;
    }

    .hero-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg,
          rgba(15, 16, 17, 0.94) 0%,
          rgba(15, 16, 17, 0.82) 35%,
          rgba(15, 16, 17, 0.58) 70%,
          rgba(15, 16, 17, 0.78) 100%
        ),
        linear-gradient(180deg,
          rgba(15, 16, 17, 0.45) 0%,
          transparent 30%,
          transparent 70%,
          rgba(15, 16, 17, 0.65) 100%
        );
      z-index: 2;
    }

    .hero-bg-item {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      animation: heroKenBurns 36s infinite both;
      animation-delay: calc(var(--i) * 6s);
      will-change: opacity, transform;
      transform-origin: center center;
    }

    .hero-bg-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: saturate(0.85) contrast(1.05);
      opacity: 0.6;
    }

    @keyframes heroKenBurns {
      0%   { opacity: 0; transform: scale(1); }
      3%   { opacity: 1; transform: scale(1.005); }
      16%  { opacity: 1; transform: scale(1.06); }
      18%  { opacity: 0; transform: scale(1.08); }
      100% { opacity: 0; transform: scale(1.08); }
    }

    @media (max-width: 640px) {
      .hero { min-height: 540px; }
      .hero-bg-item img { opacity: 0.5; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-bg-item { animation: none; opacity: 0; }
      .hero-bg-item:first-child { opacity: 1; }
    }

    .hero-mark { z-index: 2; }

    .hero .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
    }

    .hero p.lead {
      max-width: 54ch;
      color: #e0e0e2;
    }

    .hero-eyebrow { position: relative; z-index: 1; }

    /* ---- Trust bar ------------------------------------------------- */

    .trust-bar .wrap { padding: 26px var(--gutter); }

    @media (max-width: 640px) {
      .trust-bar .wrap { padding: 22px var(--gutter); gap: 14px 24px; }
    }

    /* ---- What We Do — bento grid ------------------------------------ */

    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 12px;
    }

    @media (max-width: 900px) { .service-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .service-grid { grid-template-columns: 1fr; } }

    .service-grid .service-card:first-child { grid-column: span 2; }

    @media (max-width: 900px) {
      .service-grid .service-card:first-child { grid-column: span 2; }
    }
    @media (max-width: 560px) {
      .service-grid .service-card:first-child { grid-column: span 1; }
    }

    .service-grid .service-card:first-child h3 { font-size: 1.7rem; }
    .service-grid .service-card:first-child p { font-size: 1.02rem; max-width: 60ch; }
    .service-grid .service-card:first-child .service-icon { width: 88px; height: 88px; }
    .service-grid .service-card:first-child .service-icon img { width: 42px; height: 42px; }

    /* ---- Quote band (light) --------------------------------------- */

    .quote-band {
      background: linear-gradient(135deg, var(--off-white) 0%, #ffffff 100%);
      padding: 80px 0;
      position: relative;
      overflow: hidden;
      border-top: 1px solid var(--grey-light);
      border-bottom: 1px solid var(--grey-light);
    }

    .quote-band::before {
      content: '';
      position: absolute;
      right: -100px;
      top: -100px;
      width: 380px;
      height: 380px;
      background: var(--orange);
      opacity: 0.08;
      transform: rotate(45deg);
      pointer-events: none;
    }

    .quote-band::after {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 6px;
      height: 100%;
      background: var(--orange);
    }

    .quote-band-content {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 56px;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 800px) {
      .quote-band-content { grid-template-columns: 1fr; gap: 32px; }
    }

    .quote-band-eyebrow {
      display: inline-block;
      color: var(--orange);
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 14px;
    }

    .quote-band-text h2 {
      color: var(--black);
      margin-bottom: 12px;
      max-width: 22ch;
    }

    .quote-band-text p {
      color: #4d4d4f;
      margin: 0;
      max-width: 52ch;
      font-size: 1.05rem;
    }

    .quote-band .btn {
      padding: 18px 38px;
      font-size: 1.15rem;
      white-space: nowrap;
      border-color: var(--orange);
      background: var(--orange);
      color: var(--white);
    }

    .quote-band .btn:hover,
    .quote-band .btn:focus-visible {
      background: transparent;
      color: var(--orange);
    }

    @media (max-width: 480px) {
      .quote-band { padding: 56px 0; }
      .quote-band .btn { padding: 16px 28px; font-size: 1.05rem; }
      .quote-band-text h2 { font-size: 1.8rem; }
    }

    /* ---- Reviews --------------------------------------------------- */

    .reviews-sub {
      color: #cfcfd1;
      font-size: 1.05rem;
      margin: 0 0 8px;
      max-width: 52ch;
    }

    .section--darker .review-card {
      background: #1e1f22;
      border-left: 4px solid var(--orange);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    }

    .section--darker .review-card:hover {
      background: #24262a;
      box-shadow: 0 14px 36px rgba(0, 0, 0, 0.45);
    }

    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 40px;
    }

    @media (max-width: 900px) { .reviews-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .reviews-grid { grid-template-columns: 1fr; } }

    .review-card--cta {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: linear-gradient(135deg, #1e1f22 0%, #26282c 100%);
      border-left: 4px solid var(--orange);
      text-decoration: none;
      color: inherit;
      position: relative;
      overflow: hidden;
    }

    .review-card--cta::after {
      content: '';
      position: absolute;
      right: -60px;
      bottom: -60px;
      width: 200px;
      height: 200px;
      background: var(--orange);
      opacity: 0.08;
      border-radius: 50%;
      pointer-events: none;
    }

    .review-card--cta .review-badge {
      background: var(--white);
      color: var(--black);
    }

    .review-card--cta .cta-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: var(--orange);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
      transition: transform 0.3s ease;
    }

    .review-card--cta:hover .cta-icon {
      transform: scale(1.08) rotate(-4deg);
    }

    .review-card--cta .cta-icon svg { width: 24px; height: 24px; }

    .review-card--cta h3 {
      font-family: var(--font-head);
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--white);
      margin: 0 0 8px;
      line-height: 1.2;
    }

    .review-card--cta p {
      color: #9a9a9d;
      font-size: 0.95rem;
      line-height: 1.5;
      margin: 0 0 20px;
      max-width: 100%;
    }

    .review-card--cta .cta-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 1rem;
      color: var(--orange);
      margin-top: auto;
      position: relative;
      z-index: 1;
    }

    .review-card--cta .cta-link::after {
      content: '→';
      transition: transform 0.25s ease;
    }

    .review-card--cta:hover .cta-link::after {
      transform: translateX(4px);
    }
  </style>
</head>
<body>

