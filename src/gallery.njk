<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}

  <style>
    /* ==========================================================================
       Gallery page — self-contained styles
       ========================================================================== */

    .gallery-intro {
      max-width: 56ch;
      color: #cfcfd1;
      font-size: 1.05rem;
      margin: 0;
    }

    .gallery-grid {
      column-count: 3;
      column-gap: 20px;
      margin-top: 40px;
    }

    @media (max-width: 900px) {
      .gallery-grid { column-count: 2; }
    }

    @media (max-width: 560px) {
      .gallery-grid { column-count: 1; }
    }

    .gallery-item {
      display: block;
      break-inside: avoid;
      margin-bottom: 20px;
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      background: var(--grey-light);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .gallery-item img {
      width: 100%;
      height: auto;
      display: block;
      transition: transform 0.5s ease;
    }

    .gallery-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(15, 16, 17, 0.18);
    }

    .gallery-item:hover img {
      transform: scale(1.04);
    }

    /* Gradient overlay + caption on hover */

    .gallery-item::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(15,16,17,0.75) 0%, transparent 45%);
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    .gallery-item:hover::after { opacity: 1; }

    .gallery-caption {
      position: absolute;
      left: 20px;
      right: 20px;
      bottom: 16px;
      color: var(--white);
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 0.98rem;
      line-height: 1.3;
      transform: translateY(8px);
      opacity: 0;
      transition: transform 0.3s ease, opacity 0.3s ease;
      z-index: 1;
      pointer-events: none;
    }

    .gallery-item:hover .gallery-caption {
      transform: translateY(0);
      opacity: 1;
    }

    /* ---- Quote band (same pattern as other pages) ---- */

    .quote-band {
      background: linear-gradient(135deg, var(--black) 0%, #1a1b1d 100%);
      padding: 80px 0;
      position: relative;
      overflow: hidden;
    }

    .quote-band::before {
      content: '';
      position: absolute;
      right: -100px;
      top: -100px;
      width: 380px;
      height: 380px;
      background: var(--orange);
      opacity: 0.07;
      transform: rotate(45deg);
      pointer-events: none;
    }

    .quote-band::after {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 6px;
      height: 100%;
      background: var(--orange);
    }

    .quote-band-content {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 56px;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 800px) {
      .quote-band-content {
        grid-template-columns: 1fr;
        gap: 32px;
      }
    }

    .quote-band-eyebrow {
      display: inline-block;
      color: var(--orange);
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 14px;
    }

    .quote-band-text h2 {
      color: var(--white);
      margin-bottom: 12px;
      max-width: 22ch;
    }

    .quote-band-text p {
      color: #cfcfd1;
      margin: 0;
      max-width: 52ch;
      font-size: 1.05rem;
    }

    .quote-band .btn {
      padding: 18px 38px;
      font-size: 1.15rem;
      white-space: nowrap;
      border-color: var(--orange);
      background: var(--orange);
      color: var(--white);
    }

    .quote-band .btn:hover,
    .quote-band .btn:focus-visible {
      background: transparent;
      color: var(--orange);
    }

    @media (max-width: 480px) {
      .quote-band { padding: 56px 0; }
      .quote-band .btn { padding: 16px 28px; font-size: 1.05rem; }
      .quote-band-text h2 { font-size: 1.8rem; }
    }
  </style>
</head>
<body>

