---
permalink: /whats-included/index.html
title: "What's Included | Antigravity Logistics"
description: "See what's included with every Antigravity Logistics job — professional handling, equipment and flexible solutions. Get a quote today."
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}

  <style>
    .included-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 40px;
    }

    .included-card {
      background: var(--white);
      border: 1px solid var(--grey-light);
      border-radius: 12px;
      padding: 28px 24px;
      display: flex;
      align-items: flex-start;
      gap: 18px;
      transition: transform 0.25s ease, box-shadow 0.3s ease, border-color 0.25s ease;
      position: relative;
      overflow: hidden;
    }

    .included-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; bottom: 0;
      width: 3px;
      background: var(--orange);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.3s ease;
    }

    .included-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(15, 16, 17, 0.08);
      border-color: var(--grey-light);
    }

    .included-card:hover::before { transform: scaleY(1); }

    .included-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: var(--black);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background 0.25s ease, transform 0.3s ease;
    }

    .included-card:hover .included-icon {
      background: var(--orange);
      transform: scale(1.05);
    }

    .included-icon svg { width: 22px; height: 22px; }

    .included-card h3 {
      font-family: var(--font-head);
      font-size: 1.15rem;
      font-weight: 700;
      margin: 0 0 4px;
      color: var(--black);
      letter-spacing: 0.2px;
    }

    .included-card p {
      font-size: 0.92rem;
      color: #4d4d4f;
      margin: 0;
      line-height: 1.55;
      max-width: 100%;
    }

    @media (max-width: 480px) {
      .included-card { padding: 22px 20px; gap: 14px; }
      .included-icon { width: 40px; height: 40px; }
      .included-icon svg { width: 20px; height: 20px; }
      .included-card h3 { font-size: 1.05rem; }
      .included-card p { font-size: 0.88rem; }
    }

    .pricing-section {
      background: var(--black);
      color: var(--white);
      padding: var(--section-pad) 0;
    }

    .pricing-section h2 { color: var(--white); }
    .pricing-section p { color: #cfcfd1; }

    .quote-band {
      background: linear-gradient(135deg, var(--black) 0%, #1a1b1d 100%);
      padding: 80px 0;
      position: relative;
      overflow: hidden;
    }

    .quote-band::before {
      content: '';
      position: absolute;
      right: -100px;
      top: -100px;
      width: 380px;
      height: 380px;
      background: var(--orange);
      opacity: 0.07;
      transform: rotate(45deg);
      pointer-events: none;
    }

    .quote-band::after {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 6px;
      height: 100%;
      background: var(--orange);
    }

    .quote-band-content {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 56px;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 800px) {
      .quote-band-content { grid-template-columns: 1fr; gap: 32px; }
    }

    .quote-band-eyebrow {
      display: inline-block;
      color: var(--orange);
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 14px;
    }

    .quote-band-text h2 {
      color: var(--white);
      margin-bottom: 12px;
      max-width: 22ch;
    }

    .quote-band-text p {
      color: #cfcfd1;
      margin: 0;
      max-width: 52ch;
      font-size: 1.05rem;
    }

    .quote-band .btn {
      padding: 18px 38px;
      font-size: 1.15rem;
      white-space: nowrap;
      border-color: var(--orange);
      background: var(--orange);
      color: var(--white);
    }

    .quote-band .btn:hover,
    .quote-band .btn:focus-visible {
      background: transparent;
      color: var(--orange);
    }

    @media (max-width: 480px) {
      .quote-band { padding: 56px 0; }
      .quote-band .btn { padding: 16px 28px; font-size: 1.05rem; }
      .quote-band-text h2 { font-size: 1.8rem; }
    }
  </style>
</head>
<body>

