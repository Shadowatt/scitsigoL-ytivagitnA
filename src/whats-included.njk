<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}

  <style>
    /* ==========================================================================
       What's Included page — self-contained styles
       ========================================================================== */

    .included-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-top: 40px;
    }

    @media (max-width: 1000px) { .included-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 700px)  { .included-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px)  { .included-grid { grid-template-columns: 1fr; } }

    .included-card {
      background: var(--white);
      border: 1px solid var(--grey-light);
      border-radius: 14px;
      padding: 28px 24px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }

    .included-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--orange);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.35s ease;
      z-index: 2;
    }

    .included-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 32px rgba(15, 16, 17, 0.10);
    }

    .included-card:hover::before { transform: scaleX(1); }

    /* ---- Photo layer ---------------------------------------------- */

    .card-photo {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: 0;
      transform: scale(1.06);
      transition: opacity 0.6s ease, transform 0.9s ease;
      z-index: 0;
      pointer-events: none;
    }

    /* Gradient mask — full photo on the right, fades to white on the left */

    .card-photo::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        100deg,
        var(--white) 0%,
        rgba(255, 255, 255, 0.96) 35%,
        rgba(255, 255, 255, 0.75) 60%,
        rgba(255, 255, 255, 0.35) 100%
      );
    }

    /* Desktop: hover reveals the photo */

    @media (hover: hover) and (pointer: fine) {
      .included-card:hover .card-photo {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* Touch devices (iPhone, Android, iPad, etc.):
       photos are always visible at low opacity so users can see context */

    @media (hover: none) {
      .card-photo {
        opacity: 0.22;
        transform: scale(1);
      }

      /* Stronger white fade on the left so text stays readable */

      .card-photo::after {
        background: linear-gradient(
          100deg,
          rgba(255, 255, 255, 0.99) 0%,
          rgba(255, 255, 255, 0.95) 40%,
          rgba(255, 255, 255, 0.82) 70%,
          rgba(255, 255, 255, 0.6) 100%
        );
      }
    }

    .included-card > *:not(.card-photo) {
      position: relative;
      z-index: 1;
    }

    /* ---- First card (spans 2x2) ------------------------------------ */

    .included-card:first-child {
      grid-column: span 2;
      grid-row: span 2;
      padding: 36px 32px;
      min-height: 300px;
    }

    @media (max-width: 1000px) { .included-card:first-child { grid-column: span 2; grid-row: span 2; } }
    @media (max-width: 700px)  { .included-card:first-child { grid-column: span 2; grid-row: span 1; } }
    @media (max-width: 480px)  { .included-card:first-child { grid-column: span 1; } }

    .included-card:first-child .included-icon { width: 64px; height: 64px; }
    .included-card:first-child .included-icon svg { width: 30px; height: 30px; }
    .included-card:first-child h3 { font-size: 1.6rem; }
    .included-card:first-child p { font-size: 1rem; max-width: 48ch; }

    .included-card:first-child .card-photo::after {
      background: linear-gradient(
        105deg,
        rgba(255, 255, 255, 0.98) 0%,
        rgba(255, 255, 255, 0.88) 30%,
        rgba(255, 255, 255, 0.55) 65%,
        rgba(255, 255, 255, 0.2) 100%
      );
    }

    /* ---- Icon tile ------------------------------------------------ */

    .included-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: var(--black);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background 0.3s ease, transform 0.3s ease;
    }

    .included-card:hover .included-icon {
      background: var(--orange);
      transform: scale(1.06) rotate(-4deg);
    }

    .included-icon svg { width: 24px; height: 24px; }

    /* ---- Copy ----------------------------------------------------- */

    .included-card h3 {
      font-family: var(--font-head);
      font-size: 1.2rem;
      font-weight: 700;
      margin: 0;
      color: var(--black);
      letter-spacing: 0.2px;
      line-height: 1.2;
    }

    .included-card p {
      font-size: 0.92rem;
      color: #4d4d4f;
      margin: 0;
      line-height: 1.55;
      max-width: 100%;
    }

    @media (max-width: 480px) {
      .included-card { padding: 22px 20px; }
      .included-icon { width: 42px; height: 42px; }
      .included-icon svg { width: 22px; height: 22px; }
      .included-card h3 { font-size: 1.05rem; }
      .included-card p { font-size: 0.88rem; }
    }

    /* ---- Pricing section ------------------------------------------ */

    .pricing-section {
      background: linear-gradient(135deg, var(--black) 0%, #1a1b1d 100%);
      color: var(--white);
      padding: var(--section-pad) 0;
      position: relative;
      overflow: hidden;
    }

    .pricing-section::before {
      content: '';
      position: absolute;
      right: -100px;
      top: -100px;
      width: 400px;
      height: 400px;
      background: var(--orange);
      opacity: 0.06;
      transform: rotate(45deg);
      pointer-events: none;
    }

    .pricing-section h2 { color: var(--white); }
    .pricing-section p { color: #cfcfd1; }

    .pricing-section .wrap { position: relative; z-index: 1; }

    /* ---- Quote band ------------------------------------------------ */

    .quote-band {
      background: linear-gradient(135deg, var(--black) 0%, #1a1b1d 100%);
      padding: 80px 0;
      position: relative;
      overflow: hidden;
    }

    .quote-band::before {
      content: '';
      position: absolute;
      right: -100px;
      top: -100px;
      width: 380px;
      height: 380px;
      background: var(--orange);
      opacity: 0.07;
      transform: rotate(45deg);
      pointer-events: none;
    }

    .quote-band::after {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 6px;
      height: 100%;
      background: var(--orange);
    }

    .quote-band-content {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 56px;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 800px) {
      .quote-band-content { grid-template-columns: 1fr; gap: 32px; }
    }

    .quote-band-eyebrow {
      display: inline-block;
      color: var(--orange);
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 14px;
    }

    .quote-band-text h2 { color: var(--white); margin-bottom: 12px; max-width: 22ch; }

    .quote-band-text p {
      color: #cfcfd1;
      margin: 0;
      max-width: 52ch;
      font-size: 1.05rem;
    }

    .quote-band .btn {
      padding: 18px 38px;
      font-size: 1.15rem;
      white-space: nowrap;
      border-color: var(--orange);
      background: var(--orange);
      color: var(--white);
    }

    .quote-band .btn:hover,
    .quote-band .btn:focus-visible {
      background: transparent;
      color: var(--orange);
    }

    @media (max-width: 480px) {
      .quote-band { padding: 56px 0; }
      .quote-band .btn { padding: 16px 28px; font-size: 1.05rem; }
      .quote-band-text h2 { font-size: 1.8rem; }
    }
  </style>
</head>
