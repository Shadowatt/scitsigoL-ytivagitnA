---
permalink: /contact/index.html
title: "Contact | Antigravity Logistics"
description: "Get in touch with Antigravity Logistics for transport, heavy handling and removal quotes across Sydney and NSW."
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "head.njk" %}

  <style>
    /* ==========================================================================
       Contact page — self-contained styles
       ========================================================================== */

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin-top: 40px;
    }
    @media (max-width: 700px) {
      .contact-grid { grid-template-columns: 1fr; gap: 18px; }
    }

    .contact-card {
      background: var(--white);
      border: 1px solid var(--grey-light);
      border-radius: 14px;
      padding: 32px 28px 28px;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
      box-shadow: 0 2px 10px rgba(15, 16, 17, 0.04);
    }

    /* Top-right icon badge */

    .contact-card::after {
      content: '';
      position: absolute;
      top: -40px;
      right: -40px;
      width: 130px;
      height: 130px;
      background: var(--orange);
      opacity: 0.06;
      border-radius: 50%;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    .contact-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 36px rgba(15, 16, 17, 0.10);
    }

    .contact-card:hover::after { opacity: 0.12; }

    .contact-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: var(--black);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      flex-shrink: 0;
      transition: background 0.25s ease, transform 0.3s ease;
    }

    .contact-card:hover .contact-icon {
      background: var(--orange);
      transform: scale(1.06) rotate(-3deg);
    }

    .contact-icon svg { width: 24px; height: 24px; }

    .contact-card h3 {
      font-family: var(--font-head);
      font-size: 1.4rem;
      font-weight: 700;
      margin: 0 0 6px;
      color: var(--black);
      letter-spacing: 0.2px;
    }

    .contact-card p.hint {
      font-size: 0.95rem;
      color: var(--grey);
      margin: 0 0 18px;
      line-height: 1.5;
      max-width: 100%;
    }

    .contact-card a.big-link {
      display: inline-block;
      margin-top: auto;
      font-family: var(--font-head);
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--black);
      border-bottom: 3px solid var(--orange);
      padding-bottom: 2px;
      align-self: flex-start;
      transition: color 0.2s ease;
      word-break: break-word;
    }

    .contact-card a.big-link:hover { color: var(--orange); }

    @media (max-width: 480px) {
      .contact-card { padding: 26px 22px 22px; }
      .contact-icon { width: 46px; height: 46px; margin-bottom: 16px; }
      .contact-icon svg { width: 22px; height: 22px; }
      .contact-card h3 { font-size: 1.2rem; }
      .contact-card a.big-link { font-size: 1.05rem; }
    }

    /* ---- What to include — bento grid ----------------------------- */

    .prep-section {
      background: var(--black-deep);
      color: var(--white);
      padding: var(--section-pad) 0;
      position: relative;
      overflow: hidden;
    }

    .prep-section::before {
      content: '';
      position: absolute;
      right: -100px;
      top: -100px;
      width: 400px;
      height: 400px;
      background: var(--orange);
      opacity: 0.06;
      transform: rotate(45deg);
      pointer-events: none;
    }

    .prep-header {
      max-width: 640px;
      margin-bottom: 48px;
      position: relative;
      z-index: 1;
    }

    .prep-header h2 { color: var(--white); margin-bottom: 12px; }

    .prep-header p {
      color: #cfcfd1;
      font-size: 1.05rem;
      margin: 0;
      max-width: 56ch;
    }

    .prep-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 700px) {
      .prep-grid { grid-template-columns: 1fr; gap: 16px; }
    }

    .prep-card {
      background: #1a1b1d;
      border: 1px solid #232426;
      border-radius: 14px;
      padding: 28px 26px;
      display: flex;
      align-items: flex-start;
      gap: 18px;
      transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    /* First card spans 2 columns and gets extra padding */

    .prep-card:first-child {
      grid-column: span 2;
      padding: 32px 30px;
    }

    @media (max-width: 700px) {
      .prep-card:first-child { grid-column: span 1; padding: 28px 26px; }
    }

    .prep-card:first-child h3 { font-size: 1.35rem; }
    .prep-card:first-child p { font-size: 1rem; max-width: 56ch; }

    .prep-card:hover {
      transform: translateY(-3px);
      border-color: var(--orange);
      background: #1e1f22;
    }

    .prep-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: var(--orange);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: transform 0.3s ease;
    }

    .prep-card:hover .prep-icon {
      transform: scale(1.08) rotate(-4deg);
    }

    .prep-icon svg { width: 24px; height: 24px; }

    .prep-card h3 {
      font-family: var(--font-head);
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--white);
      margin: 0 0 6px;
      letter-spacing: 0.2px;
    }

    .prep-card p {
      color: #9a9a9d;
      font-size: 0.95rem;
      line-height: 1.55;
      margin: 0;
      max-width: 100%;
    }

    @media (max-width: 480px) {
      .prep-card { padding: 22px 20px; gap: 14px; }
      .prep-icon { width: 42px; height: 42px; }
      .prep-icon svg { width: 20px; height: 20px; }
      .prep-card h3 { font-size: 1.05rem; }
      .prep-card p { font-size: 0.9rem; }
    }
  </style>
</head>
