<style>
  /* ==========================================================================
     Site header — self-contained styles (light theme + signature divider)
     ========================================================================== */

  .site-header {
    background: var(--white);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--black);
    pointer-events: none;
  }

  .site-header::before {
    content: '';
    position: absolute;
    left: var(--gutter);
    bottom: 0;
    width: 56px;
    height: 3px;
    background: var(--orange);
    z-index: 1;
    pointer-events: none;
  }

  .site-header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 100px;
    padding-top: 10px;
    padding-bottom: 10px;
    gap: 24px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--black);
    letter-spacing: 0.3px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .logo:hover,
  .logo:focus-visible {
    transform: scale(1.04);
    opacity: 0.9;
  }

  .logo img {
    display: block;
    flex-shrink: 0;
    max-width: none;
    width: 80px;
    height: 80px;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    flex-shrink: 1;
  }

  .nav-links a {
    position: relative;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--black);
    padding: 6px 0;
    transition: color 0.2s ease;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 3px;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--orange);
  }

  .nav-links a:hover::after,
  .nav-links a:focus-visible::after {
    transform: scaleX(1);
  }

  .nav-links a[aria-current="page"] {
    color: var(--black);
  }

  .nav-links a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .header-phone {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--black);
    border: 2px solid var(--orange);
    padding: 8px 16px;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .header-phone svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .header-phone:hover,
  .header-phone:focus-visible {
    background: var(--orange);
    color: var(--white);
    transform: translateY(-1px);
  }

  .header-phone:hover svg,
  .header-phone:focus-visible svg {
    transform: rotate(-12deg);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--black);
    cursor: pointer;
    padding: 8px;
    transition: color 0.2s ease, transform 0.25s ease;
  }

  .nav-toggle:hover,
  .nav-toggle:focus-visible {
    color: var(--orange);
    transform: rotate(90deg);
  }

  .nav-toggle svg { width: 26px; height: 26px; }

  @media (max-width: 900px) {
    .nav-links { gap: 20px; }
    .nav-links a { font-size: 1rem; }
  }

  @media (max-width: 800px) {
    .nav-toggle { display: block; }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--white);
      border-bottom: 3px solid var(--black);
      flex-direction: column;
      gap: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
      z-index: 2;
    }

    .nav-links.is-open { max-height: 440px; }

    .nav-links a {
      display: block;
      padding: 16px var(--gutter);
      border-bottom: 1px solid var(--grey-light);
      transition: background 0.2s ease, color 0.2s ease, padding-left 0.25s ease;
    }

    .nav-links a::after {
      display: none;
    }

    .nav-links a[aria-current="page"],
    .nav-links a:hover,
    .nav-links a:focus-visible {
      background: var(--off-white);
      border-bottom-color: var(--grey-light);
      color: var(--black);
      padding-left: calc(var(--gutter) + 8px);
    }
  }

  @media (max-width: 420px) {
    .header-phone span.phone-label { display: none; }
    .header-phone { padding: 8px 10px; }
    .logo img { width: 64px; height: 64px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo,
    .nav-links a,
    .nav-links a::after,
    .header-phone,
    .header-phone svg,
    .nav-toggle {
      transition: none;
    }
    .logo:hover,
    .header-phone:hover,
    .nav-toggle:hover {
      transform: none;
    }
    .header-phone:hover svg {
      transform: none;
    }
    .nav-links a:hover::after,
    .nav-links a[aria-current="page"]::after {
      transform: scaleX(1);
    }
  }
</style>

<header class="site-header">
  <div class="wrap">
    <a href="{{ '/' | url }}" class="logo">
      <img src="{{ '/images/logo.svg' | url }}" alt="Antigravity Logistics" width="80" height="80">
    </a>
    <nav class="nav-links" id="nav-links">
      <a href="{{ '/' | url }}" {% if page.url == '/' %}aria-current="page"{% endif %}>Home</a>
      <a href="{{ '/services/' | url }}" {% if page.url == '/services/' %}aria-current="page"{% endif %}>Services</a>
      <a href="{{ '/whats-included/' | url }}" {% if page.url == '/whats-included/' %}aria-current="page"{% endif %}>What's Included</a>
      <a href="{{ '/gallery/' | url }}" {% if page.url == '/gallery/' %}aria-current="page"{% endif %}>Gallery</a>
      <a href="{{ '/quote/' | url }}" {% if page.url == '/quote/' %}aria-current="page"{% endif %}>Get a Quote</a>
      <a href="{{ '/contact/' | url }}" {% if page.url == '/contact/' %}aria-current="page"{% endif %}>Contact</a>
    </nav>
    <div class="header-actions">
      <a href="tel:+61422553675" class="header-phone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span class="phone-label">0422 553 675</span>
      </a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>