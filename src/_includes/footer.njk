<style>
  /* ==========================================================================
     Footer — self-contained styles (light theme matching header)
     ========================================================================== */

  .site-footer {
    position: relative;
    background: var(--white);
    color: var(--black);
    padding: 64px 0 32px;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: var(--black);
    pointer-events: none;
  }

  .site-footer::after {
    content: '';
    position: absolute;
    left: var(--gutter);
    top: 0;
    width: 56px;
    height: 3px;
    background: var(--orange);
    pointer-events: none;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--grey-light);
  }

  @media (max-width: 700px) {
    .footer-grid { grid-template-columns: 1fr; }
  }

  .footer-grid h4 {
    font-family: var(--font-head);
    color: var(--black);
    font-size: 1.05rem;
    margin-bottom: 16px;
  }

  .footer-tagline {
    max-width: 40ch;
    color: #4d4d4f;
  }

  .footer-grid ul li { margin-bottom: 10px; }

  .footer-grid a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--black);
    transition: color 0.2s ease;
  }

  .footer-grid a svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .footer-grid a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .footer-grid a:hover,
  .footer-grid a:focus-visible {
    color: var(--orange);
  }

  .footer-grid a:hover svg,
  .footer-grid a:focus-visible svg {
    opacity: 1;
    transform: translateX(2px);
  }

  .footer-grid a:hover::after,
  .footer-grid a:focus-visible::after {
    transform: scaleX(1);
  }

  .footer-bottom {
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.9rem;
    color: var(--grey);
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 20px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .footer-logo:hover,
  .footer-logo:focus-visible {
    transform: scale(1.03);
    opacity: 0.9;
  }

  .footer-logo img {
    width: 120px;
    height: 120px;
    display: block;
    flex-shrink: 0;
  }

  .footer-logo::after {
    display: none;
  }

  @media (max-width: 700px) {
    .footer-logo img { width: 90px; height: 90px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-grid a,
    .footer-grid a svg,
    .footer-grid a::after,
    .footer-logo {
      transition: none;
    }
    .footer-logo:hover {
      transform: none;
    }
  }
</style>

